{
  "configurations": [
    {
      "name": "PROS Project",
      "includePath": [
        "${workspaceFolder}/include",
        "${workspaceFolder}/include/**"
      ],
      "defines": [
        "_PROS_INCLUDE_LIBLVGL_LLEMU_H",
        "_PROS_INCLUDE_LIBLVGL_LLEMU_HPP"
      ],
      "cStandard": "gnu11",
      "cppStandard": "gnu++20",
      "intelliSenseMode": "gcc-arm",
      "browse": {
        "path": [
          "${workspaceFolder}/include",
          "${workspaceFolder}/src"
        ],
        "limitSymbolsToIncludedHeaders": true,
        "databaseFilename": ""
      },
      "compileCommands": "${workspaceFolder}/compile_commands.json"
    }
  ],
  "version": 4
}
